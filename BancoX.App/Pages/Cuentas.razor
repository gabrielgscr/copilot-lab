@page "/cuentas"
@inject HttpClient Http

<PageTitle>Cuentas - Banco X</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color: var(--banco-primario);">
            <i class="bi bi-credit-card-fill me-2"></i>Cuentas Bancarias
        </h4>
        <p class="text-muted small mb-0">Consulta de cuentas registradas en el sistema</p>
    </div>
    <button class="btn btn-outline-secondary" @onclick="CargarCuentas" title="Actualizar lista">
        <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
    </button>
</div>

@if (mensajeError is not null)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@mensajeError</div>
        <button type="button" class="btn-close ms-auto" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (cargando)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando cuentas...</span>
        </div>
        <span class="ms-3 text-muted">Cargando cuentas...</span>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (cuentas is null || cuentas.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-credit-card" style="font-size: 3rem;"></i>
                    <p class="mt-3">No hay cuentas registradas en el sistema.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 tabla-banco">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Número de Cuenta</th>
                                <th>ID Cliente</th>
                                <th>Tipo</th>
                                <th class="text-end">Saldo</th>
                                <th>Estado</th>
                                <th>Fecha Apertura</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cuenta in cuentas)
                            {
                                <tr>
                                    <td class="align-middle text-muted small">@cuenta.Id</td>
                                    <td class="align-middle fw-semibold font-monospace">@cuenta.NumeroCuenta</td>
                                    <td class="align-middle text-muted small">@cuenta.ClienteId</td>
                                    <td class="align-middle">
                                        <span class="badge" style="background-color: var(--banco-acento);">
                                            @cuenta.TipoCuenta
                                        </span>
                                    </td>
                                    <td class="align-middle text-end fw-semibold">
                                        @cuenta.Saldo.ToString("C2", new System.Globalization.CultureInfo("es-MX"))
                                    </td>
                                    <td class="align-middle">
                                        @{
                                            var (badgeClass, icono) = cuenta.Estado?.ToLower() switch
                                            {
                                                "activa" => ("bg-success", "bi-check-circle-fill"),
                                                "bloqueada" => ("bg-warning text-dark", "bi-lock-fill"),
                                                "cerrada" => ("bg-secondary", "bi-x-circle-fill"),
                                                _ => ("bg-secondary", "bi-question-circle")
                                            };
                                        }
                                        <span class="badge @badgeClass">
                                            <i class="bi @icono me-1"></i>@cuenta.Estado
                                        </span>
                                    </td>
                                    <td class="align-middle text-muted small">
                                        @cuenta.FechaApertura.ToString("dd/MM/yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="px-3 py-2 text-muted small border-top">
                    Total: <strong>@cuentas.Count</strong> cuenta(s)
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Cuenta>? cuentas;
    private bool cargando = true;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarCuentas();
    }

    private async Task CargarCuentas()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            cuentas = await Http.GetFromJsonAsync<List<Cuenta>>("api/cuentas");
        }
        catch (HttpRequestException)
        {
            mensajeError = "No se pudo conectar con la API. Verifique que el servidor esté en ejecución en http://localhost:5088.";
        }
        catch (Exception)
        {
            mensajeError = "Error inesperado al cargar las cuentas. Intente de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }
}
