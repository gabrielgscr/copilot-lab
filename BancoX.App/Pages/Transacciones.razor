@page "/transacciones"
@inject HttpClient Http

<PageTitle>Transacciones - Banco X</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color: var(--banco-primario);">
            <i class="bi bi-arrow-left-right me-2"></i>Transacciones
        </h4>
        <p class="text-muted small mb-0">Historial de operaciones financieras del sistema</p>
    </div>
    <button class="btn btn-outline-secondary" @onclick="CargarTransacciones" title="Actualizar lista">
        <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
    </button>
</div>

@if (mensajeError is not null)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@mensajeError</div>
        <button type="button" class="btn-close ms-auto" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (cargando)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando transacciones...</span>
        </div>
        <span class="ms-3 text-muted">Cargando transacciones...</span>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (transacciones is null || transacciones.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-arrow-left-right" style="font-size: 3rem;"></i>
                    <p class="mt-3">No hay transacciones registradas en el sistema.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 tabla-banco">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Tipo</th>
                                <th>Cuenta Origen</th>
                                <th>Cuenta Destino</th>
                                <th class="text-end">Monto</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in transacciones)
                            {
                                <tr>
                                    <td class="align-middle text-muted small">@tx.Id</td>
                                    <td class="align-middle">
                                        @{
                                            var (tipoBadge, tipoIcono) = tx.TipoTransaccion?.ToLower() switch
                                            {
                                                "deposito" => ("bg-success", "bi-plus-circle-fill"),
                                                "retiro" => ("bg-danger", "bi-dash-circle-fill"),
                                                "transferencia" => ("bg-info", "bi-arrow-left-right"),
                                                _ => ("bg-secondary", "bi-question-circle")
                                            };
                                        }
                                        <span class="badge @tipoBadge">
                                            <i class="bi @tipoIcono me-1"></i>@tx.TipoTransaccion
                                        </span>
                                    </td>
                                    <td class="align-middle text-muted small font-monospace">
                                        @(tx.CuentaOrigenId.HasValue ? tx.CuentaOrigenId.Value.ToString() : "-")
                                    </td>
                                    <td class="align-middle text-muted small font-monospace">
                                        @(tx.CuentaDestinoId.HasValue ? tx.CuentaDestinoId.Value.ToString() : "-")
                                    </td>
                                    <td class="align-middle text-end fw-semibold">
                                        @tx.Monto.ToString("C2", new System.Globalization.CultureInfo("es-MX"))
                                    </td>
                                    <td class="align-middle">
                                        @{
                                            var (estadoBadge, estadoIcono) = tx.Estado?.ToLower() switch
                                            {
                                                "confirmada" => ("bg-success", "bi-check-circle-fill"),
                                                "pendiente" => ("bg-warning text-dark", "bi-clock-fill"),
                                                "rechazada" => ("bg-danger", "bi-x-circle-fill"),
                                                _ => ("bg-secondary", "bi-question-circle")
                                            };
                                        }
                                        <span class="badge @estadoBadge">
                                            <i class="bi @estadoIcono me-1"></i>@tx.Estado
                                        </span>
                                    </td>
                                    <td class="align-middle text-muted small">
                                        @tx.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="align-middle text-muted small">
                                        @(string.IsNullOrEmpty(tx.Descripcion) ? "-" : tx.Descripcion)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="px-3 py-2 text-muted small border-top">
                    Total: <strong>@transacciones.Count</strong> transacción(es)
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Transaccion>? transacciones;
    private bool cargando = true;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarTransacciones();
    }

    private async Task CargarTransacciones()
    {
        cargando = true;
        mensajeError = null;
        try
        {
            transacciones = await Http.GetFromJsonAsync<List<Transaccion>>("api/transacciones");
        }
        catch (HttpRequestException)
        {
            mensajeError = "No se pudo conectar con la API. Verifique que el servidor esté en ejecución en http://localhost:5088.";
        }
        catch (Exception)
        {
            mensajeError = "Error inesperado al cargar las transacciones. Intente de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }
}
