@page "/"
@inject HttpClient Http

<PageTitle>Inicio - Banco X</PageTitle>

<div class="row mb-4 align-items-center">
    <div class="col">
        <h4 class="fw-bold mb-1" style="color: var(--banco-primario);">
            <i class="bi bi-speedometer2 me-2"></i>Panel de Control
        </h4>
        <p class="text-muted mb-0">Resumen general del sistema bancario</p>
    </div>
    <div class="col-12 col-md-auto mt-3 mt-md-0">
        <span class="badge text-bg-light border px-3 py-2 text-secondary">
            <i class="bi bi-calendar-event me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy")
        </span>
    </div>
</div>

@if (mensajeError is not null)
{
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@mensajeError</div>
    </div>
}

@if (cargando)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando estadísticas...</span>
        </div>
        <span class="ms-3 text-muted">Cargando estadísticas...</span>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        <div class="col-12 col-lg-6">
            <div class="card card-estadistica card-gradiente-azul h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                        <div>
                            <div class="text-white-50 small text-uppercase fw-semibold">Clientes</div>
                            <div class="display-5 fw-bold text-white lh-1 mt-2">@totalClientes</div>
                            <div class="text-white-50 mt-2 small">Registros activos en el sistema</div>
                        </div>
                        <div class="card-icono-destacado text-white">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                    <a href="clientes" class="btn btn-light btn-sm fw-semibold">
                        Ver detalle <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card card-estadistica card-gradiente-indigo h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                        <div>
                            <div class="text-white-50 small text-uppercase fw-semibold">Cuentas</div>
                            <div class="display-5 fw-bold text-white lh-1 mt-2">@totalCuentas</div>
                            <div class="text-white-50 mt-2 small">Productos bancarios registrados</div>
                        </div>
                        <div class="card-icono-destacado text-white">
                            <i class="bi bi-credit-card-fill"></i>
                        </div>
                    </div>
                    <a href="cuentas" class="btn btn-light btn-sm fw-semibold">
                        Ver detalle <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icono-panel-resumen">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Vista general de operación</div>
                            <div class="text-muted small">Monitoreo rápido de clientes y cuentas para seguimiento diario.</div>
                        </div>
                    </div>
                    <a href="transacciones" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-left-right me-1"></i>Ir a Transacciones
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="card border-0 shadow-sm">
                <div class="card-header" style="background-color: var(--banco-claro);">
                    <h6 class="mb-0 fw-semibold" style="color: var(--banco-primario);">
                        <i class="bi bi-info-circle me-2"></i>Acerca del Sistema
                    </h6>
                </div>
                <div class="card-body">
                    <p class="mb-2 text-muted">
                        <strong>Banco X</strong> es un sistema bancario que permite gestionar clientes,
                        cuentas bancarias y transacciones financieras de manera eficiente y segura.
                    </p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="clientes" class="btn btn-sm btn-banco-primario">
                            <i class="bi bi-people me-1"></i> Gestionar Clientes
                        </a>
                        <a href="cuentas" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-credit-card me-1"></i> Ver Cuentas
                        </a>
                        <a href="transacciones" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-arrow-left-right me-1"></i> Ver Transacciones
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int totalClientes;
    private int totalCuentas;
    private bool cargando = true;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadisticas();
    }

    private async Task CargarEstadisticas()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            var clientes = await Http.GetFromJsonAsync<List<Cliente>>("api/clientes");
            totalClientes = clientes?.Count ?? 0;

            var cuentas = await Http.GetFromJsonAsync<List<Cuenta>>("api/cuentas");
            totalCuentas = cuentas?.Count ?? 0;
        }
        catch (HttpRequestException)
        {
            mensajeError = "No se pudo conectar con la API de Banco X. Verifique que el servidor esté en ejecución en http://localhost:5088.";
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error inesperado al cargar las estadísticas. Intente de nuevo más tarde.";
        }
        finally
        {
            cargando = false;
        }
    }
}
